{
  "schema": "edge-model-benchmark/suite-v1",
  "id": "workflow-development",
  "split": "development",
  "system": "你是机器人助手。设备操作使用提供的工具；角色与普通聊天用文字回答。",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "start_camera",
        "description": "恢复采集，不把发布完成当作设备开启确认。",
        "parameters": {
          "additionalProperties": false,
          "description": "无模型参数的动作。",
          "properties": {},
          "title": "NoArguments",
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "stop_camera",
        "description": "先确认 Follow standby，再暂停采集，失败则不继续。",
        "parameters": {
          "additionalProperties": false,
          "description": "无模型参数的动作。",
          "properties": {},
          "title": "NoArguments",
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "enable_lidar",
        "description": "开启 tracker 扫描融合，保留服务端 TF/发布端检查。",
        "parameters": {
          "additionalProperties": false,
          "description": "无模型参数的动作。",
          "properties": {},
          "title": "NoArguments",
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "disable_lidar",
        "description": "关闭融合，服务确认后记录其隐含的 Follow standby。",
        "parameters": {
          "additionalProperties": false,
          "description": "无模型参数的动作。",
          "properties": {},
          "title": "NoArguments",
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "enable_tracking",
        "description": "仅启用 Follow，保留融合尚未开启时服务端拒绝的语义。",
        "parameters": {
          "additionalProperties": false,
          "description": "无模型参数的动作。",
          "properties": {},
          "title": "NoArguments",
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "disable_tracking",
        "description": "仅进入 Follow 待机，保持当前融合订阅。",
        "parameters": {
          "additionalProperties": false,
          "description": "无模型参数的动作。",
          "properties": {},
          "title": "NoArguments",
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "following_status",
        "description": "读取ObjectTrack当前状态；不可用时不猜测或返回旧缓存。",
        "parameters": {
          "additionalProperties": false,
          "description": "无模型参数的动作。",
          "properties": {},
          "title": "NoArguments",
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "volume_set",
        "description": "模拟源 level 的整数转换与0至100饱和。",
        "parameters": {
          "additionalProperties": false,
          "description": "音量执行时量化并按原契约饱和。",
          "properties": {
            "level": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "default": 50,
              "description": "音量，执行时取整并限制在0至100",
              "title": "Level"
            }
          },
          "title": "LevelInput",
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "play_music",
        "description": "模拟切换当前歌曲，保留等待队列。",
        "parameters": {
          "additionalProperties": false,
          "description": "歌曲与队列接受非空名称。",
          "properties": {
            "song_name": {
              "description": "歌曲名称",
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "title": "Song Name",
              "type": "string"
            }
          },
          "required": [
            "song_name"
          ],
          "title": "SongInput",
          "type": "object"
        }
      }
    }
  ],
  "samples": [
    {
      "id": "development_000",
